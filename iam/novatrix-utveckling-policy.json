{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListaBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ListaNovatrixBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::novatrix-assets-697520883832"
    },
    {
      "Sid": "LasSkrivObjekt",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::novatrix-assets-697520883832/*"
    }
  ]
}
